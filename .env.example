# Copy to .env.local. `npx convex dev` writes both of these for you.

# The deployment the browser talks to. Without it the app has nothing to
# serve and `/` says so; point it at the test deployment for local work.
PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud

# Used by the Convex CLI, not by the app.
CONVEX_DEPLOYMENT=dev:your-deployment-123
