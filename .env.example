# Copy to .env.local and fill in. `npx convex dev` writes both of these for you.

# The deployment the browser talks to. Leave it unset to run Cacao in local
# mode, where all data lives in localStorage and starts empty -- use
# "Import 2064 data" on the Admin page to fill it.
PUBLIC_CONVEX_URL=https://your-deployment-123.convex.cloud

# Written by `npx convex dev`; used by the Convex CLI, not by the app.
CONVEX_DEPLOYMENT=dev:your-deployment-123
