{
  "name": "cacao",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 5173",
    "dev:convex": "convex dev",
    "build": "vite build",
    "build:vercel": "convex deploy --cmd 'npm run build' --cmd-url-env-var-name PUBLIC_CONVEX_URL",
